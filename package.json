{
  "name": "gomila-rider-control",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "security-test": "tsx tests/security.integration.test.ts",
    "test:security": "tsx tests/security.integration.test.ts",
    "test:admin": "tsx tests/adminUser.integration.test.ts",
    "test:unit": "tsx tests/phase1.test.ts && tsx tests/phase2.test.ts && tsx tests/phase3.test.ts && tsx tests/phase4.test.ts && tsx tests/logistics.test.ts && tsx tests/adminUser.test.ts && tsx tests/shopifySync.test.ts && tsx tests/riderRouteAndBulkAssign.test.ts && tsx tests/operationalChain.test.ts && tsx --test tests/dispatchAndRiderCustody.test.ts && tsx --test tests/deliveryAndCodPosting.test.ts",
    "test:emulator:suite": "tsx --test tests/security.integration.test.ts tests/adminUser.integration.test.ts",
    "test": "npm run test:unit",
    "test:emulator": "firebase emulators:exec --only auth,firestore,storage \"npm run test:emulator:suite\"",
    "test:emulators": "firebase emulators:exec --only auth,firestore,storage \"npm run test:emulator:suite\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "firebase": "^12.17.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "^5.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.25.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
